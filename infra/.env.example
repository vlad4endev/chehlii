# ── Общие ─────────────────────────────────────────────
APP_ENV=local                       # local | dev | prod
LOG_LEVEL=INFO
SENTRY_DSN=                         # пусто локально; заполняется на dev/prod

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=casetop
POSTGRES_PASSWORD=change_me
POSTGRES_DB=casetop
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis (FSM ботов + очередь задач APScheduler) ─────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── Backend / безопасность AdminUI ────────────────────
# Общий секрет бот → backend. Публичны только GET каталога/hero/отзывов; заказы,
# клиенты, outbox, ссылки оплаты доступны только с этим заголовком. ОБЯЗАТЕЛЬНО
# задать на проде (длинная случайная строка), иначе внутренний API открыт всем.
INTERNAL_API_TOKEN=change_me_long_random
JWT_SECRET=change_me_long_random
JWT_ACCESS_TTL_MINUTES=1440
JWT_REFRESH_TTL_DAYS=14

# Локальные медиа (фото каталога, материалы, макеты, консультации).
# В Docker монтируется как ./media:/app/media — без bind-mount файлы пропадут
# при пересборке. Метаданные и SHA-256 — в таблице media_assets; архив — на
# Яндекс.Диске (см. ниже). При пропаже локального файла backend восстанавливает
# его с Диска по disk_url из реестра.
MEDIA_ROOT=/app/media

# ── Яндекс Диск (архив файлов: каталог, клиент, макеты, консультации) ─
# Приложение: https://oauth.yandex.ru/  права: cloud_api:disk.write/read/info
# Без токена макеты дизайнера не загрузятся; остальные типы — best-effort архив.
YANDEX_DISK_CLIENT_ID=
YANDEX_DISK_CLIENT_SECRET=
YANDEX_DISK_OAUTH_TOKEN=
YANDEX_DISK_ROOT=/chechlii/orders

# ── Боты (заполняются на этапе интеграции) ────────────
TG_BOT_TOKEN=
MAX_BOT_TOKEN=

# ── Платёжные шлюзы (Спринт 4; выбор шлюза — открытый вопрос R3) ─
PAYMENT_GATEWAY_TG=                 # robokassa | cloudpayments | tbank
PAYMENT_GATEWAY_MAX=                # tbank
PAYMENT_TG_MERCHANT=
PAYMENT_TG_SECRET=
PAYMENT_MAX_MERCHANT=
PAYMENT_MAX_SECRET=

# ── Отмена заказа / напоминания (часы и минуты) ───────
PAYMENT_REMINDERS_MINUTES=5,45,180,1440
ORDER_AUTOCANCEL_HOURS=72
